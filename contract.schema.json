{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edd-framework.github.io/edd-core/contract.schema.json",
  "title": "EDD Contract",
  "description": "Schema for EDD Lean v2 contracts (.edd/contracts/*.yaml)",
  "type": "object",
  "required": [
    "schema",
    "contract_id",
    "profile",
    "intent",
    "hypothesis",
    "claims"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "edd/contract/v2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$",
      "description": "Unique kebab-case identifier in UPPER-KEBAB-CASE"
    },
    "profile": {
      "type": "string",
      "enum": [
        "express",
        "standard",
        "governed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "verified_premerge",
        "merged",
        "deployed",
        "validated_live",
        "closed",
        "failed",
        "falsified",
        "superseded",
        "waived",
        "inconclusive"
      ],
      "default": "draft"
    },
    "intent": {
      "type": "object",
      "required": [
        "actor",
        "problem",
        "outcome"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "outcome": {
          "type": "object",
          "required": [
            "observable",
            "baseline",
            "threshold",
            "instrument",
            "sample",
            "window"
          ],
          "properties": {
            "observable": {
              "type": "string"
            },
            "baseline": {
              "type": "string"
            },
            "threshold": {
              "type": "string"
            },
            "instrument": {
              "type": "string"
            },
            "sample": {
              "type": "string"
            },
            "window": {
              "type": "string"
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "type": "object",
          "properties": {
            "approver": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "approved_section_sha": {
              "type": "string"
            }
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "statement",
        "falsified_when"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "based_on": {
          "type": "string"
        },
        "falsified_when": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "phase",
          "statement",
          "evaluators"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "functional",
              "regression",
              "product",
              "safety",
              "performance",
              "security"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "premerge",
              "live"
            ]
          },
          "blocking": {
            "type": "boolean",
            "default": true
          },
          "statement": {
            "type": "string"
          },
          "evaluators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "fail_to_pass",
                    "pass_to_pass",
                    "measurement",
                    "structural",
                    "human"
                  ]
                },
                "run": {
                  "type": "string"
                },
                "expect": {
                  "type": "string",
                  "default": "exit 0"
                }
              }
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "mandatory"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "release",
              "architecture",
              "security",
              "destructive_action"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "technical_approval": {
      "type": "object",
      "properties": {
        "approver": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_section_sha": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "merge_requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live_close_requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
